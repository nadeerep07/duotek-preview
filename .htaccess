# =========================================================
# DUOTEK GROUP — Apache Server Configuration (Hostinger)
# =========================================================

RewriteEngine On
RewriteBase /

# 1. Force HTTPS and canonical non-www (https://duotek.ae/)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.duotek\.ae$ [NC]
RewriteRule ^(.*)$ https://duotek.ae/$1 [L,R=301]

# 2. Strip trailing slash for non-directories (e.g., /about/ -> /about)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 3. Seamless Clean URLs (loads .html files without extension in URL)
# e.g., /about -> about.html, /services -> services.html, /contact -> contact.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# 4. Redirect legacy WordPress / old indexed URLs to new pages
RewriteRule ^wp-.*$ / [R=301,L]
RewriteRule ^pharmacy.*$ /services.html [R=301,L]
RewriteRule ^services/.*$ /services.html [R=301,L]
RewriteRule ^about-us/?$ /about.html [R=301,L]
RewriteRule ^contact-us/?$ /contact.html [R=301,L]
RewriteRule ^it-.*$ /services.html [R=301,L]
RewriteRule ^cctv.*$ /services.html [R=301,L]
RewriteRule ^annual-.*$ /services.html [R=301,L]
RewriteRule ^biometric.*$ /services.html [R=301,L]
RewriteRule ^structured-.*$ /services.html [R=301,L]
RewriteRule ^network-.*$ /services.html [R=301,L]
RewriteRule ^solutions/.*$ /services.html [R=301,L]
RewriteRule ^products/.*$ /services.html [R=301,L]

# 5. Custom Branded 404 Error Page
ErrorDocument 404 /404.html
